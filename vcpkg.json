{
  "name": "hydrahook",
  "version": "4.2.0",
  "description": "DirectX and Core Audio API-hooking framework",
  "license": "MIT",
  "supports": "!(arm | uwp)",
  "dependencies": [
    "spdlog",
    "detours",
    {
      "name": "imgui",
      "platform": "x86",
      "default-features": false,
      "features": [ "dx9-binding", "dx10-binding", "dx11-binding", "win32-binding" ]
    },
    {
      "name": "imgui",
      "platform": "!x86",
      "default-features": false,
      "features": [ "dx9-binding", "dx10-binding", "dx11-binding", "dx12-binding", "win32-binding" ]
    },
    {
      "name": "directxtk",
      "features": [ "tools" ]
    },
    "opencv4"
  ]
}
