<Project>
  <!-- VcpkgRoot is resolved in Directory.Build.props and carries over here. -->
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" />
  <!--
    Bootstrap the local submodule only when it is checked out but has not yet
    been compiled (first local build after cloning with submodules).
    The script holds a mutex: every project sees a missing vcpkg.exe at
    evaluation time and would otherwise download it in parallel.
  -->
  <ItemDefinitionGroup Condition="'$(VcpkgEnabled)' != 'false' And Exists('$(VcpkgRoot)bootstrap-vcpkg.bat') And !Exists('$(VcpkgRoot)vcpkg.exe')">
    <PreBuildEvent>
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory).github\scripts\Bootstrap-VcpkgOnce.ps1"</Command>
      <Message>Bootstrap vcpkg</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>

  <!--
    vcpkg writes the package tree to <install-root>/<triplet>/.
    The MSBuild install root is already vcpkg_installed/<triplet>/, so headers,
    libs, and tools land in vcpkg_installed/<triplet>/<triplet>/.
    Keep each triplet in its own install root so an x86 install does not delete x64.
  -->
  <PropertyGroup Condition="'$(VcpkgEnableManifest)' == 'true'">
    <_ZVcpkgCurrentInstalledDir>$(_ZVcpkgInstalledDir)$(VcpkgTriplet)\</_ZVcpkgCurrentInstalledDir>
  </PropertyGroup>
</Project>
